{
  "project": "CLIENT_PROJECT_NAME",
  "title": "Knowledge, Attitude and Practice of Nurses Towards Diabetic Foot Care",
  "data": "../clients/CLIENT/data.xlsx",
  "output_dir": "../output",
  "alpha": 0.05,
  "demographics": ["age_group", "gender", "nationality", "education", "experience", "facility", "training"],
  "scales": {
    "Knowledge": {"items": ["K1","K2","K3","K4","K5","K6","K7","K8","K9","K10"], "item_min": 0, "item_max": 1,
                  "cutoffs_pct": [60, 80], "labels": ["Poor", "Moderate", "Good"], "binary_cutoff_pct": 60},
    "Attitude":  {"items": ["A1","A2","A3","A4","A5","A6","A7","A8"], "item_min": 1, "item_max": 5,
                  "reverse_items": ["A8"], "cutoffs_pct": [60, 80], "labels": ["Negative", "Neutral", "Positive"]},
    "Practice":  {"items": ["P1","P2","P3","P4","P5","P6","P7"], "item_min": 0, "item_max": 1,
                  "cutoffs_pct": [60, 80], "labels": ["Poor", "Fair", "Good"], "binary_cutoff_pct": 60}
  },
  "item_tables": true,
  "group_comparisons": {"outcomes": ["Knowledge_score", "Attitude_score", "Practice_score"],
                        "by": ["age_group", "gender", "nationality", "education", "experience", "facility", "training"]},
  "associations": {"outcomes": ["Knowledge_level"], "by": ["gender", "education", "experience", "training"]},
  "correlations": ["Knowledge_score", "Attitude_score", "Practice_score"],
  "logistic": {"outcome": "Practice_adequate", "event": "Adequate",
               "predictors": ["gender", "education", "experience", "training", "Knowledge_score"],
               "reference": {"gender": "Female", "education": "Diploma", "training": "No", "experience": "<5 years"}}
}
